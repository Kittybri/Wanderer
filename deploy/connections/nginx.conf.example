# EXAMPLE ONLY. Configure a real DNS name/certificate and validate nginx -t first.
# Do not enable upstream/proxy/WAF URL or header capture for these routes.
server {
    listen 443 ssl;
    server_name connect.example.invalid;
    ssl_certificate /etc/letsencrypt/live/connect.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/connect.example.invalid/privkey.pem;
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 8k;

    location ~ ^/(oauth/google/(start/[^/]+|callback)|health)$ {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host connect.example.invalid;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_cache off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    # Public pages for Google app verification: copy static files from
    # deploy/connections/public to /var/www/bot-connections before enabling.
    # Keep all OAuth start/callback URLs unlogged (including CDN/WAF layers).
    location = / {
        root /var/www/bot-connections;
        try_files /index.html =404;
    }
    location = /privacy {
        alias /var/www/bot-connections/privacy.html;
        default_type text/html;
    }

    location / { return 404; }
}
